{
  "env": {
    "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS": "1",
    "DISABLE_TELEMETRY": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(. \"$NVM_DIR/nvm.sh\":*)",
      "Bash(./install:*)",
      "Bash([:*)",
      "Bash(bash:*)",
      "Bash(cd *)",
      "Bash(chmod:*)",
      "Bash(codex:*)",
      "Bash(command:*)",
      "Bash(curl:*)",
      "Bash(echo:*)",
      "Bash(export NVM_DIR=\"$HOME/.nvm\":*)",
      "Bash(export PATH:*)",
      "Bash(find:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(lark-cli *)",
      "Bash(ls:*)",
      "Bash(mmctl jobs get *)",
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(nvm install:*)",
      "Bash(source:*)",
      "Bash(vela get-*)",
      "Bash(vela list-*)",
      "Bash(~/.nvm/versions/node/v24.13.0/bin/codex:*)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ],
    "deny": [],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/check_dangerous_ops.sh"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "[[ \"$CLAUDE_FILE\" == *.sh ]] && shellcheck --shell=bash \"$CLAUDE_FILE\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/check-expert-update.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/verify-project.sh",
            "timeout": 30,
            "statusMessage": "Verifying syntax..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/claudeception-activator.sh"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/claude-end-reminder.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/claude-end-reminder.sh"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/claude-end-reminder.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "feishu@minimax-plugins": true,
    "humanize@PolyArch": true,
    "notion@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "ecc@ecc": true
  },
  "extraKnownMarketplaces": {
    "minimax-matrix-plugins": {
      "source": {
        "source": "git",
        "url": "https://gitlab.xaminim.com/common/plugins.git"
      }
    },
    "anthropic-agent-skills": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/skills.git"
      }
    },
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    },
    "PolyArch": {
      "source": {
        "source": "github",
        "repo": "PolyArch/humanize"
      }
    },
    "ecc": {
      "source": {
        "source": "git",
        "url": "https://github.com/affaan-m/ECC.git"
      }
    }
  },
  "language": "Chinese",
  "skipWebFetchPreflight": true,
  "autoUpdatesChannel": "latest",
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "verbose": true,
  "teammateMode": "tmux"
}
