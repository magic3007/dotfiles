# zsh reads ~/.zshenv for every invocation, including non-interactive remote
# commands. Mobile/remote Codex clients may execute `codex` without loading
# ~/.zshrc, so tools installed through nvm are otherwise invisible to PATH.
# Keep this file small and side-effect free.
_nvm_node="$HOME/.nvm/versions/node"
if [ -d "$_nvm_node" ]; then
  _latest="$(ls "$_nvm_node" | sort -V | tail -1)"
  [ -n "$_latest" ] && export PATH="$_nvm_node/$_latest/bin:$PATH"
fi
unset _nvm_node _latest
