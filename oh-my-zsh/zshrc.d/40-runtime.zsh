# The only place zsh loads the settings shared with bash: aliases, functions,
# PATH, history options, and ~/.common_shell_setup_local.sh.
[[ -f ~/.common_shell_setup.sh ]] && source ~/.common_shell_setup.sh

# Collapse duplicate PATH entries after the shared setup added its directories.
typeset -U path PATH
path=($path)

# Lazy-load nvm only when needed.
export NVM_DIR="$HOME/.nvm"
if [[ -s "$NVM_DIR/nvm.sh" ]]; then
  nvm() {
    unfunction nvm 2>/dev/null
    source "$NVM_DIR/nvm.sh"
    [[ -s "$NVM_DIR/bash_completion" ]] && source "$NVM_DIR/bash_completion"
    nvm "$@"
  }
fi

# bun shell completions, generated by bun outside this repository
[[ -s "$HOME/.bun/_bun" ]] && source "$HOME/.bun/_bun"

# Codex proxy wrapper. No-op when the wrapper is not installed. It is sourced
# here, after the shared setup, so its directory outranks ~/.local/bin.
[[ -f "$DOTFILES_ROOT/oh-my-zsh/codex-proxy.zsh" ]] && source "$DOTFILES_ROOT/oh-my-zsh/codex-proxy.zsh"
