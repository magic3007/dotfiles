[submodule "neovim/nvim-basic-ide"]
	path = neovim/nvim-basic-ide
	url = https://github.com/magic3007/nvim-basic-ide.git
[submodule "ranger/plugins/ranger_devicons"]
	path = ranger/plugins/ranger_devicons
	url = https://github.com/alexanderjeurissen/ranger_devicons.git
	branch = main
[submodule "vim/vimrc"]
	path = vim/vimrc
	url = https://github.com/magic3007/vimrc.git
	branch = custom
[submodule "dotbot"]
	path = dotbot
	url = https://github.com/anishathalye/dotbot
	ignore = dirty
[submodule "pi/my-pi-plugins"]
	path = pi/my-pi-plugins
	url = https://github.com/magic3007/my-pi-plugins.git
