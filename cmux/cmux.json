{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,

  "app": {
    "language": "zh-Hans",
    "appearance": "dark",
    "windowTitleTemplate": "[cmux] {activeWorkspace}",
    "newWorkspacePlacement": "afterCurrent",
    "workspaceInheritWorkingDirectory": true,
    "confirmQuit": "always",
    "openSupportedFilesInCmux": true,
    "openMarkdownInCmuxViewer": true,
    "forkConversationDefaultDestination": "right",
    "focusPaneOnFirstClick": true,
    "minimalMode": false,
    "renameSelectsExistingName": true,
    "menuBarOnly": false,
    "globalFontMagnification": 100,
    "commandPaletteSearchesAllSurfaces": false,
    "reorderOnNotification": true,
    "iMessageMode": false,
    "keepWorkspaceOpenWhenClosingLastSurface": false
  },

  "terminal": {
    "showScrollBar": true,
    "scrollSpeed": 1,
    "autoResumeAgentSessions": true,
    "copyOnSelect": false,
    "showTextBoxOnNewTerminals": false,
    "focusTextBoxOnNewTerminals": false,
    "textBoxMaxLines": 10,
    "sessionContentMaxWidth": false,
    "sessionContentAlignment": "center",
    "agentHibernation": {
      "enabled": true,
      "idleSeconds": 300,
      "maxLiveTerminals": 12
    },
    "rendererRealization": {
      "enabled": true,
      "maxWarmRenderers": 12,
      "idleSeconds": 30
    },
    "textBoxSubmitActions": [
      {
        "id": "claude",
        "title": "Claude Code",
        "kind": "commandTemplate",
        "commandTemplate": "claude --dangerously-skip-permissions -- {{prompt}}",
        "backgroundColorHex": "#F6D5C8",
        "systemImage": "sparkle"
      },
      {
        "id": "codex",
        "title": "Codex --yolo",
        "kind": "commandTemplate",
        "commandTemplate": "codex --yolo -- {{prompt}}",
        "backgroundColorHex": "#8FDBFF",
        "systemImage": "sparkles"
      },
      {
        "id": "gemini",
        "title": "Gemini",
        "kind": "commandTemplate",
        "commandTemplate": "gemini --yolo -- {{prompt}}",
        "backgroundColorHex": "#B5E48C",
        "systemImage": "brain.head.profile"
      },
      {
        "id": "opencode",
        "title": "OpenCode",
        "kind": "commandTemplate",
        "commandTemplate": "opencode --prompt {{prompt}}",
        "backgroundColorHex": "#D0B3FF",
        "systemImage": "curlybraces"
      }
    ]
  },

  "notifications": {
    "dockBadge": true,
    "showInMenuBar": true,
    "unreadPaneRing": true,
    "paneFlash": true,
    "suppressOnlyFocusedSurface": false,
    "agentPermissionPrompt": true,
    "agentTurnComplete": "whenIdle",
    "agentIdleReminder": true,
    "sound": "default"
  },

  "sidebar": {
    "showBranchDirectory": true,
    "showWorkspaceDescription": true,
    "showPullRequests": true,
    "makePullRequestsClickable": true,
    "openPullRequestLinksInCmuxBrowser": true,
    "openPortLinksInCmuxBrowser": true,
    "showSSH": true,
    "showPorts": true,
    "showLog": true,
    "showProgress": true,
    "showAgentActivity": true,
    "showNotificationMessage": true,
    "notificationMessageLineLimit": 12,
    "watchGitStatus": true,
    "showCustomMetadata": true,
    "branchLayout": "vertical",
    "wrapWorkspaceTitles": false,
    "hideAllDetails": false,
    "loadingSpinnerPosition": "leading",
    "notificationBadgePosition": "leading"
  },

  "workspaceColors": {
    "indicatorStyle": "leftRail"
  },

  "sidebarAppearance": {
    "matchTerminalBackground": false,
    "tintColor": "#000000",
    "tintOpacity": 0.03
  },

  "automation": {
    "socketControlMode": "cmuxOnly",
    "claudeCodeIntegration": true,
    "cursorIntegration": true,
    "geminiIntegration": true,
    "kiroIntegration": true,
    "ampIntegration": true,
    "suppressSubagentNotifications": true,
    "workspaceAutoNaming": true,
    "autoNamingAgent": "auto",
    "portBase": 9100,
    "portRange": 10
  },

  "workspaceGroups": {
    "newWorkspacePlacement": "afterCurrent"
  },

  "ui": {
    "newWorkspaceButton": "default",
    "surfaceTabBarNewButton": "default",
    "surfaceTabBarPlusMenu": "default"
  },

  "agentChat": {
    "startCommand": ""
  },

  "browser": {
    "defaultSearchEngine": "google",
    "theme": "system",
    "showSearchSuggestions": true,
    "openTerminalLinksInCmuxBrowser": true,
    "interceptTerminalOpenCommandInCmuxBrowser": true,
    "discardHiddenWebViews": true,
    "hiddenWebViewDiscardDelaySeconds": 300,
    "askWhereToSaveDownloads": false
  },

  "markdown": {
    "fontSize": 15,
    "maxWidth": 980
  },

  "fileEditor": {
    "wordWrap": false
  },

  "fileExplorer": {
    "doubleClickAction": "preview"
  },

  "diffViewer": {
    "defaultLayout": "unified"
  },

  "shortcuts": {
    "showModifierHoldHints": true,
    "bindings": {
      "toggleSidebar": "cmd+b",
      "commandPalette": "cmd+shift+p",
      "openSettings": "cmd+,",
      "reloadConfiguration": "cmd+shift+,",
      "newTab": "cmd+n",
      "closeWorkspace": "cmd+shift+w",
      "splitRight": "cmd+d",
      "splitDown": "cmd+shift+d",
      "newSurface": "cmd+t",
      "closeTab": "cmd+w",
      "find": "cmd+f",
      "findInDirectory": "cmd+shift+f",
      "goToWorkspace": "cmd+p",
      "openFolder": "cmd+o",
      "quit": "cmd+q",
      "renameWorkspace": "cmd+shift+r",
      "openBrowser": "cmd+shift+l",
      "focusBrowserAddressBar": "cmd+l",
      "toggleSplitZoom": "cmd+shift+return",
      "showNotifications": "cmd+i",
      "jumpToUnread": "cmd+shift+u",
      "showHideAllWindows": "ctrl+opt+cmd+.",
      "newWindow": "cmd+shift+n",
      "closeWindow": "ctrl+cmd+w",
      "toggleFullScreen": "ctrl+cmd+f",
      "globalSearch": "opt+cmd+f",
      "toggleFileExplorer": "cmd+opt+b",
      "focusLeft": "opt+cmd+left",
      "focusRight": "opt+cmd+right",
      "focusUp": "opt+cmd+up",
      "focusDown": "opt+cmd+down",
      "newBrowserWorkspace": "opt+cmd+n",
      "selectWorkspaceByNumber": "cmd+1",
      "selectSurfaceByNumber": "ctrl+1",
      "toggleCanvasLayout": "ctrl+cmd+c",
      "openDiffViewer": "ctrl+cmd+shift+d",
      "saveLayoutTemplate": "ctrl+cmd+s",
      "reopenPreviousSession": "cmd+shift+o",
      "renameTab": "cmd+r",
      "cycleWorkspaceStatus": "cmd+shift+;",
      "markWorkspaceDone": "cmd+;",
      "toggleTerminalCopyMode": "cmd+shift+m",
      "focusTextBoxInput": "cmd+shift+a",
      "clearScreenKeepScrollback": "cmd+shift+k",
      "sendFeedback": ""
    }
  }
}
