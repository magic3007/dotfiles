+-- Neovim 0.12 hands predicate/directive handlers the captures as a list of
+-- nodes per capture id (one pattern can bind several nodes), while the 0.8 API
+-- this plugin targets passed the node itself. Take the first bound node, which
+-- is what every handler below wants, and keep working on older Neovim.
+local function captured_node(match, id)
+  local captured = match[id]
+  if type(captured) == "table" then
+    return captured[1]
+  end
+  return captured
+end
