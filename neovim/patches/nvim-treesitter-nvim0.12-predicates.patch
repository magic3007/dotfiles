 local query = require "vim.treesitter.query"
 
+-- Neovim 0.12+ ships some of these predicates/directives natively, and
+-- re-registering an existing name is a hard error there (the builtin
+-- implementation is kept). Tolerate only that specific conflict; anything
+-- else is a real failure and is re-raised.
+local function tolerant(add)
+  return function(name, handler, ...)
+    local ok, err = pcall(add, name, handler, ...)
+    if not ok and not tostring(err):match "Overriding existing" then
+      error(err)
+    end
+  end
+end
+
+local add_predicate = tolerant(query.add_predicate)
+local add_directive = tolerant(query.add_directive)
+
 local function error(str)
   vim.api.nvim_err_writeln(str)
 end
