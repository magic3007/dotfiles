--- a/maestro/adapters/pi/child/pin-session.ts	1970-01-01 08:00:00.000000000 +0800
+++ b/maestro/adapters/pi/child/pin-session.ts	2026-10-28 15:59:08.717304858 +0800
@@ -0,0 +1,25 @@
+/**
+ * omp child hook: pin the child session file to the path the parent expects.
+ *
+ * The Pi adapter passes the child session path with `pi --session <file>`. omp
+ * has no such flag — it always allocates a file under its own session dir — so
+ * the launch passes the path in `PI_HERDR_AGENTS_SESSION` instead and this hook
+ * redirects the writer to it during `session_start`. Sidecar (`<file>.exit`),
+ * activity file, result extraction and `subagent_resume` all keep working
+ * because every one of them reads that same path.
+ */
+export default function pinSession(pi: {
+	on(
+		event: "session_start",
+		handler: (
+			event: unknown,
+			ctx: { sessionManager: { setSessionFile(path: string): void } },
+		) => Promise<void>,
+	): void;
+}) {
+	pi.on("session_start", async (_event, ctx) => {
+		const target = process.env.PI_HERDR_AGENTS_SESSION;
+		if (!target) return;
+		ctx.sessionManager.setSessionFile(target);
+	});
+}
