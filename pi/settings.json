{
  "theme": "gruvbox-dark",
  "defaultProvider": "dspro",
  "defaultModel": "deepseek-v4-flash[1m]",
  "powerline": {
    "preset": "default",
    "layout": {
      "left": [
        "model",
        "thinking",
        "shell_mode",
        "path",
        "git",
        "session",
        "queue",
        "context_pct",
        "cache_read",
        "cost"
      ]
    }
  },
  "lastChangelogVersion": "0.85.1",
  "packages": [
    "my-pi-plugins",
    "npm:pi-powerline-footer@0.12.2",
    "npm:pi-web-access",
    "git:github.com/obra/superpowers"
  ],
  "skills": [
    "~/.pi/agent/skills"
  ],
  "terminal": {
    "showTerminalProgress": true
  },
  "hideThinkingBlock": true,
  "defaultThinkingLevel": "off",
  "images": {
    "blockImages": false
  }
}